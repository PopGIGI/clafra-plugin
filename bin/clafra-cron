#!/usr/bin/env bash
# clafra-cron — nightly full validation for every repo in the repos file.
#
# Crontab:  17 3 * * * /home/pop/clafra-plugin/bin/clafra-cron >> ~/.local/state/clafra/cron.log 2>&1
#
# Repos file (one absolute path per line, # comments ok): $CLAFRA_REPOS
#   default ~/.config/clafra/repos
# Runs `clafra validate --full` (every check, no cache, no LLM). Results land in each
# repo's .clafra/state.json, so stale skills surface at the next session start and in
# the read-time rules. Each repo runs independently; one failure never skips the others.

set -uo pipefail

BIN="$(cd "$(dirname "$0")" && pwd)"
REPOS="${CLAFRA_REPOS:-$HOME/.config/clafra/repos}"
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"

log() { printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

[[ -f "$REPOS" ]] || { log "no repos file at $REPOS"; exit 1; }

fail=0
while IFS= read -r repo; do
    repo="${repo%%#*}"; repo="${repo//[[:space:]]/}"
    [[ -n "$repo" ]] || continue
    if [[ ! -d "$repo" ]]; then
        log "SKIP $repo: not a directory"; fail=1; continue
    fi
    out="$(cd "$repo" && CLAFRA_ROOT="$repo" "$BIN/clafra" validate --full 2>&1)"
    rc=$?
    stale="$(grep -c '^✗' <<<"$out")"
    log "$([[ $rc -eq 0 ]] && echo OK || echo STALE) $repo: $(grep -c '^[✓✗]' <<<"$out") skills, $stale stale${stale:+$( [[ $stale -gt 0 ]] && printf ' (%s)' "$(grep '^✗' <<<"$out" | cut -d' ' -f2 | tr -d ':' | paste -sd, -)")}"
    [[ $rc -le 1 ]] || fail=1
done < "$REPOS"
exit $fail
